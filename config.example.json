{
  "port": 80,
  "host": "127.0.0.1",
  "fileRoot": "./servers",
  "backupRoot": "./storage/backups",
  "logRoot": "./storage/logs",
  "uploadRoot": "./storage/uploads",
  "trustProxy": 0,
  "limits": {
    "maxFileGb": 500,
    "uploadChunkMb": 16,
    "minFreeDiskMb": 256,
    "uploadSessionHours": 48,
    "maxActiveUploads": 8,
    "maxZipItems": 2000
  },
  "timeouts": {
    "requestMinutes": 20,
    "idleMinutes": 20,
    "headersSeconds": 60,
    "keepAliveSeconds": 65,
    "uploadStallSeconds": 60,
    "proxyIdleMinutes": 20
  }
}
