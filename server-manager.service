[Unit]
Description=Server Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Запускайте от отдельного пользователя без прав root: приложения, которые запускает панель, получат только его права
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__NODE__ server.js
Restart=on-failure
RestartSec=5
# Порты ниже 1024 (например, 80) без root
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Много открытых файлов нужно большим папкам и многим соединениям
LimitNOFILE=65535
# Остановка службы останавливает и все запущенные панелью приложения
KillMode=control-group
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
